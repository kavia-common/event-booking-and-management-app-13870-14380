# VenueService environment variables example
# Copy this file to `.env` and adjust values for your environment.

# Service metadata
SERVICE_NAME=VenueService
SERVICE_VERSION=0.1.0
SERVICE_DESCRIPTION=Venue and seating management service for the Event Platform.

# CORS origins (comma-separated). Use * for all origins in development.
CORS_ALLOW_ORIGINS=*

# Security placeholders (actual auth is handled by API Gateway; these are for local testing)
AUTH_DISABLED=true
ADMIN_API_KEY=change-me
ORGANIZER_API_KEY=change-me

# Websocket broadcast control (no external broker used in this stub)
WEBSOCKETS_ENABLED=true
